{
  "name": "bgcm",
  "version": "0.1.0",
  "description": "BTL Git and Claude Manager - git repo visualizer and Claude Code session finder",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "bgcm": "cli/bgcm.js"
  },
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --watch",
    "start": "node cli/bgcm.js",
    "install-desktop": "node scripts/install-desktop.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@preact/signals": "2.11.3",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "node-pty": "1.1.0",
    "preact": "11.0.1",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/ws": "8.18.2",
    "esbuild": "0.28.2",
    "preact-render-to-string": "^6.8.0",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
